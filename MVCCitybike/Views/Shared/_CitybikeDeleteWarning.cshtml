@* Reusable Delete Warning Component *@
@model (string Title, string EntityType)

<div class="citybike-delete-header">
    <h1 class="citybike-delete-title">@Model.Title</h1>
    <p class="citybike-delete-warning">⚠️ Tämä toiminto ei ole palautettavissa</p>
</div>

<div class="citybike-delete-message">
    <h3>Oletko varma, että haluat poistaa tämän @Model.EntityType.ToLower()?</h3>
    <p>Kaikki @Model.EntityType.ToLower() liittyvät tiedot poistetaan pysyvästi.</p>
</div>
