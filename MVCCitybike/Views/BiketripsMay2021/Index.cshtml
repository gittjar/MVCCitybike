@model PaginatedList<MVCCitybike.Models.BiketripsMay2021>

@{
    ViewData["Title"] = "Index";
}

<div class="citybike-container">
    @await Html.PartialAsync("_CitybikeHero", ("PYÖRÄMATKAT", "Selaa ja hallinnoi pyörämatkoja"))

    <!-- Action Bar -->
    <div class="citybike-action-bar">
        <a asp-action="Create" class="citybike-btn citybike-btn-primary">
            <span>+ Luo Uusi Matka</span>
        </a>
    </div>

    <!-- Search Section -->
    <div class="citybike-search-section">
        <form asp-action="Index" method="get" class="citybike-search-form">
            <div class="citybike-search-inputs">
                <div class="citybike-input-group flex-grow">
                    <input type="text" class="citybike-input" name="SearchString" value="@ViewData["CurrentFilter"]" placeholder="Etsi lähtö- tai palautusaseman nimellä...">
                </div>
                <button class="citybike-btn citybike-btn-search" type="submit">
                    <span>Etsi</span>
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="citybike-btn citybike-btn-outline">
                        <span>Tyhjennä</span>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Trips Grid -->
    <div class="citybike-trips-grid">
        @foreach (var item in Model)
        {
            <div class="citybike-trip-card">
                <div class="citybike-trip-header">
                    <div class="citybike-trip-route">
                        <div class="citybike-trip-station">
                            <span class="citybike-trip-label">Lähtö</span>
                            <span class="citybike-trip-station-name">@item.Departure_station_name</span>
                            <span class="citybike-trip-station-id">ID: @item.Departure_station_id</span>
                        </div>
                        <div class="citybike-trip-arrow">→</div>
                        <div class="citybike-trip-station">
                            <span class="citybike-trip-label">Palautus</span>
                            <span class="citybike-trip-station-name">@item.Return_station_name</span>
                            <span class="citybike-trip-station-id">ID: @item.Return_station_id</span>
                        </div>
                    </div>
                </div>
                
                <div class="citybike-trip-body">
                    <div class="citybike-trip-stats">
                        <div class="citybike-trip-stat">
                            <span class="citybike-stat-value">@((item.Covered_distance_m / 1000).ToString("F2")) km</span>
                            <span class="citybike-stat-label">Matka</span>
                        </div>
                        <div class="citybike-trip-stat">
                            <span class="citybike-stat-value">@TimeSpan.FromSeconds(item.Duration_sec).ToString(@"hh\:mm\:ss")</span>
                            <span class="citybike-stat-label">Kesto</span>
                        </div>
                    </div>
                    
                    <div class="citybike-trip-times">
                        <div class="citybike-trip-time">
                            <span class="citybike-time-label">Lähtöaika</span>
                            <span class="citybike-time-value">@item.Departure.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="citybike-trip-time">
                            <span class="citybike-time-label">Palautusaika</span>
                            <span class="citybike-time-value">@item.Return.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
                
                <div class="citybike-card-actions">
                    <a asp-action="Details" asp-route-id="@item.ID" class="citybike-action-link">
                        <span>Lisätiedot</span>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="citybike-action-link">
                        <span>Muokkaa</span>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="citybike-action-link citybike-action-link-danger">
                        <span>Poista</span>
                    </a>
                </div>
            </div>
        }
    </div>

    @await Html.PartialAsync("_CitybikePagination", Model)
</div>