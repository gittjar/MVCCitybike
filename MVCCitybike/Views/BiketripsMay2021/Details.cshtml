@model MVCCitybike.Models.BiketripsMay2021

@{
    ViewData["Title"] = "Details";
}

<div class="nike-container">
    <!-- Header -->
    <div class="nike-details-header">
        <h1 class="nike-details-title">MATKAN TIEDOT</h1>
        <div class="nike-details-actions">
            <a asp-action="Edit" asp-route-id="@Model?.ID" class="nike-btn nike-btn-secondary">
                <span>Muokkaa</span>
            </a>
            <a asp-action="Index" class="nike-btn nike-btn-outline">
                <span>Takaisin</span>
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="nike-details-card">
        <!-- Route Overview -->
        <div class="nike-trip-route-detail">
            <div class="nike-route-station">
                <span class="nike-route-label">Lähtöasema</span>
                <h2 class="nike-route-name">@Model?.Departure_station_name</h2>
                <span class="nike-route-id">ID: @Model?.Departure_station_id</span>
            </div>
            <div class="nike-route-arrow">→</div>
            <div class="nike-route-station">
                <span class="nike-route-label">Palautusasema</span>
                <h2 class="nike-route-name">@Model?.Return_station_name</h2>
                <span class="nike-route-id">ID: @Model?.Return_station_id</span>
            </div>
        </div>

        <!-- Stats -->
        <div class="nike-trip-stats-detail">
            <div class="nike-stat-box">
                <span class="nike-stat-value-large">@(((double)Model!.Covered_distance_m / 1000).ToString("F2")) km</span>
                <span class="nike-stat-label">Kokonaismatka</span>
            </div>
            <div class="nike-stat-box">
                <span class="nike-stat-value-large">@TimeSpan.FromSeconds(Model.Duration_sec).ToString(@"hh\:mm\:ss")</span>
                <span class="nike-stat-label">Matkan Kesto</span>
            </div>
            <div class="nike-stat-box">
                <span class="nike-stat-value-large">@((((double)Model.Covered_distance_m / 1000) / (Model.Duration_sec / 3600.0)).ToString("F1")) km/h</span>
                <span class="nike-stat-label">Keskinopeus</span>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="nike-details-grid">
            <div class="nike-details-section">
                <h2 class="nike-section-title">Lähtötiedot</h2>
                
                <div class="nike-detail-item">
                    <span class="nike-detail-label">Lähtöaika</span>
                    <span class="nike-detail-value">@Model?.Departure.ToString("dd.MM.yyyy HH:mm:ss")</span>
                </div>

                <div class="nike-detail-item">
                    <span class="nike-detail-label">Lähtöasema</span>
                    <span class="nike-detail-value">@Model?.Departure_station_name</span>
                </div>

                <div class="nike-detail-item">
                    <span class="nike-detail-label">Aseman ID</span>
                    <span class="nike-detail-value">@Model?.Departure_station_id</span>
                </div>
            </div>

            <div class="nike-details-section">
                <h2 class="nike-section-title">Palautustiedot</h2>
                
                <div class="nike-detail-item">
                    <span class="nike-detail-label">Palautusaika</span>
                    <span class="nike-detail-value">@Model?.Return.ToString("dd.MM.yyyy HH:mm:ss")</span>
                </div>

                <div class="nike-detail-item">
                    <span class="nike-detail-label">Palautusasema</span>
                    <span class="nike-detail-value">@Model?.Return_station_name</span>
                </div>

                <div class="nike-detail-item">
                    <span class="nike-detail-label">Aseman ID</span>
                    <span class="nike-detail-value">@Model?.Return_station_id</span>
                </div>
            </div>
        </div>
    </div>
</div>
