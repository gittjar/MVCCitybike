@model MVCCitybike.Models.BiketripsMay2021

@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">MATKAN TIEDOT</h1>
        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-secondary">Muokkaa</a>
            <a asp-action="Index" class="btn btn-outline-dark">Takaisin</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <!-- Route Overview -->
        <div class="card-header bg-primary text-white p-4">
            <div class="row align-items-center text-center">
                <div class="col-md-5">
                    <small class="text-uppercase">Lähtöasema</small>
                    <h3 class="fw-bold mb-1">@Model?.Departure_station_name</h3>
                    <small>ID: @Model?.Departure_station_id</small>
                </div>
                <div class="col-md-2">
                    <h1 class="display-4 mb-0">→</h1>
                </div>
                <div class="col-md-5">
                    <small class="text-uppercase">Palautusasema</small>
                    <h3 class="fw-bold mb-1">@Model?.Return_station_name</h3>
                    <small>ID: @Model?.Return_station_id</small>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="card-body bg-light">
            <div class="row g-3 text-center">
                <div class="col-md-4">
                    <div class="card border-primary">
                        <div class="card-body">
                            <h2 class="display-6 fw-bold text-primary mb-0">@Html.FormatDistance(Model!.Covered_distance_m)</h2>
                            <p class="text-muted mb-0">Kokonaismatka</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body">
                            <h2 class="display-6 fw-bold text-success mb-0">@Html.FormatDuration(Model.Duration_sec)</h2>
                            <p class="text-muted mb-0">Matkan Kesto</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info">
                        <div class="card-body">
                            <h2 class="display-6 fw-bold text-info mb-0">@Html.CalculateSpeed(Model.Covered_distance_m, Model.Duration_sec)</h2>
                            <p class="text-muted mb-0">Keskinopeus</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <h3 class="h4 mb-3 fw-bold border-bottom pb-2 text-success">Lähtötiedot</h3>
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Lähtöaika</dt>
                        <dd class="col-sm-8 fw-bold">@DataFormatters.FormatDateTimeWithSeconds(Model!.Departure)</dd>
                        
                        <dt class="col-sm-4 text-muted">Lähtöasema</dt>
                        <dd class="col-sm-8 fw-bold">@Model?.Departure_station_name</dd>
                        
                        <dt class="col-sm-4 text-muted">Aseman ID</dt>
                        <dd class="col-sm-8"><span class="badge bg-success">@Model?.Departure_station_id</span></dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h3 class="h4 mb-3 fw-bold border-bottom pb-2 text-danger">Palautustiedot</h3>
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Palautusaika</dt>
                        <dd class="col-sm-8 fw-bold">@DataFormatters.FormatDateTimeWithSeconds(Model!.Return)</dd>
                        
                        <dt class="col-sm-4 text-muted">Palautusasema</dt>
                        <dd class="col-sm-8 fw-bold">@Model?.Return_station_name</dd>
                        
                        <dt class="col-sm-4 text-muted">Aseman ID</dt>
                        <dd class="col-sm-8"><span class="badge bg-danger">@Model?.Return_station_id</span></dd>
                    </dl>
                </div>
            </div>
        </div>
        
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between">
                <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-secondary">Muokkaa</a>
                <a asp-action="Index" class="btn btn-dark">Takaisin Listaan</a>
            </div>
        </div>
    </div>
</div>
