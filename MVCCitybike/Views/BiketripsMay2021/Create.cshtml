@model MVCCitybike.Models.BiketripsMay2021

@{
    ViewData["Title"] = "Create";
}

<div class="nike-container">
    <!-- Header -->
    <div class="nike-form-header">
        <h1 class="nike-form-title">LUO UUSI MATKA</h1>
        <p class="nike-form-subtitle">Täytä pyörämatkan tiedot alla olevaan lomakkeeseen</p>
    </div>

    <!-- Form Card -->
    <div class="nike-form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="nike-validation-summary"></div>
            
            <div class="nike-form-grid">
                <!-- Column 1 -->
                <div class="nike-form-column">
                    <div class="nike-form-group">
                        <label asp-for="Departure" class="nike-label">Lähtöaika</label>
                        <input asp-for="Departure" class="nike-input" type="datetime-local" />
                        <span asp-validation-for="Departure" class="nike-validation"></span>
                    </div>

                    <div class="nike-form-group">
                        <label asp-for="Return" class="nike-label">Palautusaika</label>
                        <input asp-for="Return" class="nike-input" type="datetime-local" />
                        <span asp-validation-for="Return" class="nike-validation"></span>
                    </div>

                    <div class="nike-form-group">
                        <label asp-for="Departure_station_id" class="nike-label">Lähtöaseman ID</label>
                        <input asp-for="Departure_station_id" class="nike-input" type="number" />
                        <span asp-validation-for="Departure_station_id" class="nike-validation"></span>
                    </div>

                    <div class="nike-form-group">
                        <label asp-for="Departure_station_name" class="nike-label">Lähtöaseman Nimi</label>
                        <input asp-for="Departure_station_name" class="nike-input" />
                        <span asp-validation-for="Departure_station_name" class="nike-validation"></span>
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="nike-form-column">
                    <div class="nike-form-group">
                        <label asp-for="Return_station_id" class="nike-label">Palautusaseman ID</label>
                        <input asp-for="Return_station_id" class="nike-input" type="number" />
                        <span asp-validation-for="Return_station_id" class="nike-validation"></span>
                    </div>

                    <div class="nike-form-group">
                        <label asp-for="Return_station_name" class="nike-label">Palautusaseman Nimi</label>
                        <input asp-for="Return_station_name" class="nike-input" />
                        <span asp-validation-for="Return_station_name" class="nike-validation"></span>
                    </div>

                    <div class="nike-form-group">
                        <label asp-for="Covered_distance_m" class="nike-label">Ajettu Matka (m)</label>
                        <input asp-for="Covered_distance_m" class="nike-input" type="number" step="0.01" />
                        <span asp-validation-for="Covered_distance_m" class="nike-validation"></span>
                    </div>

                    <div class="nike-form-group">
                        <label asp-for="Duration_sec" class="nike-label">Kesto (s)</label>
                        <input asp-for="Duration_sec" class="nike-input" type="number" />
                        <span asp-validation-for="Duration_sec" class="nike-validation"></span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="nike-form-actions">
                <button type="submit" class="nike-btn nike-btn-primary nike-btn-large">
                    <span>Luo Matka</span>
                </button>
                <a asp-action="Index" class="nike-btn nike-btn-secondary nike-btn-large">
                    <span>Peruuta</span>
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
