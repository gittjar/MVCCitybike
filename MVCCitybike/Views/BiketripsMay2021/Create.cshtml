@model MVCCitybike.Models.BiketripsMay2021

@{
    ViewData["Title"] = "Create";
}

<div class="citybike-container">
    @await Html.PartialAsync("_CitybikeHero", ("LUO UUSI MATKA", "Täytä pyörämatkan tiedot alla olevaan lomakkeeseen"))

    <div class="citybike-form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="citybike-validation-summary"></div>
            
            <div class="citybike-form-grid">
                <div class="citybike-form-column">
                    <div class="citybike-form-group">
                        <label asp-for="Departure" class="citybike-label">Lähtöaika</label>
                        <input asp-for="Departure" class="citybike-input" type="datetime-local" />
                        <span asp-validation-for="Departure" class="citybike-validation"></span>
                    </div>
                    <div class="citybike-form-group">
                        <label asp-for="Return" class="citybike-label">Palautusaika</label>
                        <input asp-for="Return" class="citybike-input" type="datetime-local" />
                        <span asp-validation-for="Return" class="citybike-validation"></span>
                    </div>
                    <div class="citybike-form-group">
                        <label asp-for="Departure_station_id" class="citybike-label">Lähtöaseman ID</label>
                        <input asp-for="Departure_station_id" class="citybike-input" type="number" />
                        <span asp-validation-for="Departure_station_id" class="citybike-validation"></span>
                    </div>
                    <div class="citybike-form-group">
                        <label asp-for="Departure_station_name" class="citybike-label">Lähtöaseman Nimi</label>
                        <input asp-for="Departure_station_name" class="citybike-input" />
                        <span asp-validation-for="Departure_station_name" class="citybike-validation"></span>
                    </div>
                </div>
                <div class="citybike-form-column">
                    <div class="citybike-form-group">
                        <label asp-for="Return_station_id" class="citybike-label">Palautusaseman ID</label>
                        <input asp-for="Return_station_id" class="citybike-input" type="number" />
                        <span asp-validation-for="Return_station_id" class="citybike-validation"></span>
                    </div>
                    <div class="citybike-form-group">
                        <label asp-for="Return_station_name" class="citybike-label">Palautusaseman Nimi</label>
                        <input asp-for="Return_station_name" class="citybike-input" />
                        <span asp-validation-for="Return_station_name" class="citybike-validation"></span>
                    </div>
                    <div class="citybike-form-group">
                        <label asp-for="Covered_distance_m" class="citybike-label">Ajettu Matka (m)</label>
                        <input asp-for="Covered_distance_m" class="citybike-input" type="number" step="0.01" />
                        <span asp-validation-for="Covered_distance_m" class="citybike-validation"></span>
                    </div>
                    <div class="citybike-form-group">
                        <label asp-for="Duration_sec" class="citybike-label">Kesto (s)</label>
                        <input asp-for="Duration_sec" class="citybike-input" type="number" />
                        <span asp-validation-for="Duration_sec" class="citybike-validation"></span>
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_CitybikeFormActions", ("Luo Matka", "Index"))
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
