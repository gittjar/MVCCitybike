@model MVCCitybike.Models.BiketripsMay2021

@{
    ViewData["Title"] = "Edit";
}

<div class="citybike-container">
    @await Html.PartialAsync("_CitybikeHero", ("MUOKKAA MATKAA", "Päivitä pyörämatkan tiedot alla olevassa lomakkeessa"))

    <!-- Form Card -->
    <div class="citybike-form-card">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="citybike-validation-summary"></div>
            <input type="hidden" asp-for="ID" />
            
            @await Html.PartialAsync("_BiketripFormFields", Model)

            @await Html.PartialAsync("_CitybikeFormActions", ("Tallenna Muutokset", "Index"))
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
