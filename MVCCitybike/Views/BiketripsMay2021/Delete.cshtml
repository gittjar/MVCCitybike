@model MVCCitybike.Models.BiketripsMay2021

@{
    ViewData["Title"] = "Delete";
}

<div class="citybike-container">
    @await Html.PartialAsync("_CitybikeDeleteWarning", ("POISTA MATKA", "matkan"))

    <div class="citybike-delete-card">
        <div class="citybike-delete-info">
            <div class="citybike-delete-highlight">
                <h2>@Model?.Departure_station_name → @Model?.Return_station_name</h2>
                <p>@Model?.Departure.ToString("dd.MM.yyyy HH:mm")</p>
            </div>

            <div class="citybike-trip-route-detail">
                <div class="citybike-route-station">
                    <span class="citybike-route-label">Lähtöasema</span>
                    <h3 class="citybike-route-name">@Model?.Departure_station_name</h3>
                    <span class="citybike-route-id">ID: @Model?.Departure_station_id</span>
                </div>
                <div class="citybike-route-arrow">→</div>
                <div class="citybike-route-station">
                    <span class="citybike-route-label">Palautusasema</span>
                    <h3 class="citybike-route-name">@Model?.Return_station_name</h3>
                    <span class="citybike-route-id">ID: @Model?.Return_station_id</span>
                </div>
            </div>

            <div class="citybike-delete-details">
                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Lähtöaika</span>
                    <span class="citybike-detail-value">@Model?.Departure.ToString("dd.MM.yyyy HH:mm:ss")</span>
                </div>
                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Palautusaika</span>
                    <span class="citybike-detail-value">@Model?.Return.ToString("dd.MM.yyyy HH:mm:ss")</span>
                </div>
                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Matka</span>
                    <span class="citybike-detail-value">@(((double)Model!.Covered_distance_m / 1000).ToString("F2")) km</span>
                </div>
                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Kesto</span>
                    <span class="citybike-detail-value">@TimeSpan.FromSeconds(Model.Duration_sec).ToString(@"hh\:mm\:ss")</span>
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <div class="citybike-delete-actions">
                <button type="submit" class="citybike-btn citybike-btn-danger citybike-btn-large">
                    <span>Kyllä, Poista Matka</span>
                </button>
                <a asp-action="Index" class="citybike-btn citybike-btn-secondary citybike-btn-large">
                    <span>Peruuta</span>
                </a>
            </div>
        </form>
    </div>
</div>
