@{
    ViewData["Title"] = "Run Tests";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1>🧪 Automated Testing Dashboard</h1>
            <p class="lead">Run automated unit tests to verify application functionality</p>
            
            <div class="card mt-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Test Suite Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>📋 What Gets Tested:</h6>
                            <ul>
                                <li><strong>Station Tests:</strong> CRUD operations, filtering, validation</li>
                                <li><strong>Biketrip Tests:</strong> Data integrity, calculations, sorting</li>
                                <li><strong>Database Tests:</strong> In-memory database operations</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>✅ Test Coverage:</h6>
                            <ul>
                                <li>Create, Read, Update, Delete operations</li>
                                <li>Data filtering and searching</li>
                                <li>Business logic validation</li>
                                <li>Edge cases and error handling</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-body text-center">
                    <h5>Ready to run tests?</h5>
                    <p>Click the button below to execute all automated tests</p>
                    
                    <form asp-action="RunTests" method="post">
                        <button type="submit" class="btn btn-success btn-lg mt-3" id="runTestsBtn">
                            <i class="bi bi-play-circle"></i> Run All Tests
                        </button>
                    </form>
                    
                    <div class="mt-3 text-muted">
                        <small>⏱️ Tests typically complete in 2-5 seconds</small>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-4">
                <h6><i class="bi bi-info-circle"></i> Note:</h6>
                <p class="mb-0">
                    Tests use an in-memory database and do not affect your production data.
                    All test data is created and destroyed automatically.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    #runTestsBtn {
        min-width: 200px;
        font-size: 1.2rem;
        padding: 12px 30px;
    }
    
    #runTestsBtn:hover {
        transform: scale(1.05);
        transition: all 0.2s;
    }
</style>

<script>
    document.querySelector('form').addEventListener('submit', function() {
        const btn = document.getElementById('runTestsBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Running Tests...';
    });
</script>
