@model MVCCitybike.Models.StationCityViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="nike-container">
    <!-- Hero Section -->
    <div class="nike-hero">
        <h1 class="nike-title">ASEMALUETTELO</h1>
        <p class="nike-subtitle">Hallinnoi pyöräasemia moderneilla työkaluilla</p>
    </div>

    <!-- Action Bar -->
    <div class="nike-action-bar">
        <a asp-action="Create" class="nike-btn nike-btn-primary">
            <span>+ Luo Uusi Asema</span>
        </a>
    </div>

    <!-- Search Section -->
    <div class="nike-search-section">
        <form asp-controller="Station" asp-action="Index" method="get" class="nike-search-form">
            <div class="nike-search-inputs">
                <div class="nike-input-group">
                    <select class="nike-select" asp-for="StationKaupunki" asp-items="Model.Kaupungit">
                        <option value="">Valitse kaupunki</option>
                    </select>
                </div>
                <div class="nike-input-group flex-grow">
                    <input type="text" class="nike-input" name="SearchItem" placeholder="Etsi aseman nimellä...">
                </div>
                <button class="nike-btn nike-btn-search" type="submit">
                    <span>Etsi</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Stations Grid -->
    <div class="nike-stations-grid">
        @foreach (var item in Model.Stations!)
        {
            <div class="nike-station-card">
                <div class="nike-card-header">
                    <span class="nike-card-id">ID: @item.FID</span>
                    <span class="nike-card-capacity">@item.Kapasiteet kapasiteetti</span>
                </div>
                <div class="nike-card-body">
                    <h3 class="nike-card-title">@item.Nimi</h3>
                    <div class="nike-card-info">
                        <div class="nike-info-item">
                            <span class="nike-info-label">Osoite</span>
                            <span class="nike-info-value">@item.Osoite</span>
                        </div>
                        <div class="nike-info-item">
                            <span class="nike-info-label">Kaupunki</span>
                            <span class="nike-info-value">@item.Kaupunki</span>
                        </div>
                        <div class="nike-info-item">
                            <span class="nike-info-label">Operaattori</span>
                            <span class="nike-info-value">@item.Operaattor</span>
                        </div>
                        <div class="nike-info-item">
                            <span class="nike-info-label">Koordinaatit</span>
                            <span class="nike-info-value">@item.y, @item.x</span>
                        </div>
                    </div>
                </div>
                <div class="nike-card-actions">
                    <a asp-action="Details" asp-route-id="@item.ID" class="nike-action-link">
                        <span>Lisätiedot</span>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="nike-action-link">
                        <span>Muokkaa</span>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="nike-action-link nike-action-link-danger">
                        <span>Poista</span>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

