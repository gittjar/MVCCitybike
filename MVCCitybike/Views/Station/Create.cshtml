@model MVCCitybike.Models.Station

@{
    ViewData["Title"] = "Create";
}

<div class="citybike-container">
    @await Html.PartialAsync("_CitybikeHero", ("LUO UUSI ASEMA", "Täytä aseman tiedot alla olevaan lomakkeeseen"))

    <!-- Form Card -->
    <div class="citybike-form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="citybike-validation-summary"></div>
            
            @await Html.PartialAsync("_StationFormFields", Model)

            @await Html.PartialAsync("_CitybikeFormActions", ("Luo Asema", "Index"))
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}