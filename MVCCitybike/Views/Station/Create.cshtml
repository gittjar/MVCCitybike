@model MVCCitybike.Models.Station

@{
    ViewData["Title"] = "Create";
}

<div class="citybike-container">
    <!-- Header -->
    <div class="citybike-form-header">
        <h1 class="citybike-form-title">LUO UUSI ASEMA</h1>
        <p class="citybike-form-subtitle">Täytä aseman tiedot alla olevaan lomakkeeseen</p>
    </div>

    <!-- Form Card -->
    <div class="citybike-form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="citybike-validation-summary"></div>
            
            <div class="citybike-form-grid">
                <!-- Column 1 -->
                <div class="citybike-form-column">
                    <div class="citybike-form-group">
                        <label asp-for="FID" class="citybike-label">FID</label>
                        <input asp-for="FID" class="citybike-input" />
                        <span asp-validation-for="FID" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Nimi" class="citybike-label">Nimi (FI)</label>
                        <input asp-for="Nimi" class="citybike-input" />
                        <span asp-validation-for="Nimi" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Namn" class="citybike-label">Namn (SE)</label>
                        <input asp-for="Namn" class="citybike-input" />
                        <span asp-validation-for="Namn" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Name" class="citybike-label">Name (EN)</label>
                        <input asp-for="Name" class="citybike-input" />
                        <span asp-validation-for="Name" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Osoite" class="citybike-label">Osoite (FI)</label>
                        <input asp-for="Osoite" class="citybike-input" />
                        <span asp-validation-for="Osoite" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Adress" class="citybike-label">Adress (SE)</label>
                        <input asp-for="Adress" class="citybike-input" />
                        <span asp-validation-for="Adress" class="citybike-validation"></span>
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="citybike-form-column">
                    <div class="citybike-form-group">
                        <label asp-for="Kaupunki" class="citybike-label">Kaupunki (FI)</label>
                        <input asp-for="Kaupunki" class="citybike-input" />
                        <span asp-validation-for="Kaupunki" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Stad" class="citybike-label">Stad (SE)</label>
                        <input asp-for="Stad" class="citybike-input" />
                        <span asp-validation-for="Stad" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Operaattor" class="citybike-label">Operaattori</label>
                        <input asp-for="Operaattor" class="citybike-input" />
                        <span asp-validation-for="Operaattor" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="Kapasiteet" class="citybike-label">Kapasiteetti</label>
                        <input asp-for="Kapasiteet" class="citybike-input" />
                        <span asp-validation-for="Kapasiteet" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="x" class="citybike-label">Longitude (X)</label>
                        <input asp-for="x" class="citybike-input" />
                        <span asp-validation-for="x" class="citybike-validation"></span>
                    </div>

                    <div class="citybike-form-group">
                        <label asp-for="y" class="citybike-label">Latitude (Y)</label>
                        <input asp-for="y" class="citybike-input" />
                        <span asp-validation-for="y" class="citybike-validation"></span>
                    </div>
                </div>
            </div>

            <!-- Full Width -->
            <div class="citybike-form-group citybike-form-full">
                <label asp-for="Kuva" class="citybike-label">Kuvan URL</label>
                <input asp-for="Kuva" class="citybike-input" />
            </div>

            <!-- Action Buttons -->
            <div class="citybike-form-actions">
                <button type="submit" class="citybike-btn citybike-btn-primary citybike-btn-large">
                    <span>Luo Asema</span>
                </button>
                <a asp-action="Index" class="citybike-btn citybike-btn-secondary citybike-btn-large">
                    <span>Peruuta</span>
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
