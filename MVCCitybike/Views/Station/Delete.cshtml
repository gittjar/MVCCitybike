@model MVCCitybike.Models.Station

@{
    ViewData["Title"] = "Delete";
}

<div class="citybike-container">
    <!-- Header -->
    <div class="citybike-delete-header">
        <h1 class="citybike-delete-title">POISTA ASEMA</h1>
        <p class="citybike-delete-warning">⚠️ Tämä toiminto ei ole palautettavissa</p>
    </div>

    <!-- Delete Card -->
    <div class="citybike-delete-card">
        <div class="citybike-delete-message">
            <h3>Oletko varma, että haluat poistaa tämän aseman?</h3>
            <p>Kaikki asemaan liittyvät tiedot poistetaan pysyvästi.</p>
        </div>

        <!-- Station Info -->
        @if (!string.IsNullOrEmpty(Model?.Kuva))
        {
            <div class="citybike-delete-image">
                <img src="@Model.Kuva" alt="@Model.Nimi">
            </div>
        }

        <div class="citybike-delete-info">
            <div class="citybike-delete-highlight">
                <h2>@Model?.Nimi</h2>
                <p>@Model?.Osoite, @Model?.Kaupunki</p>
            </div>

            <div class="citybike-delete-details">
                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">FID</span>
                    <span class="citybike-detail-value">@Model?.FID</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Nimi (FI)</span>
                    <span class="citybike-detail-value">@Model?.Nimi</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Namn (SE)</span>
                    <span class="citybike-detail-value">@Model?.Namn</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Name (EN)</span>
                    <span class="citybike-detail-value">@Model?.Name</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Osoite</span>
                    <span class="citybike-detail-value">@Model?.Osoite</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Kaupunki</span>
                    <span class="citybike-detail-value">@Model?.Kaupunki</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Operaattori</span>
                    <span class="citybike-detail-value">@Model?.Operaattor</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Kapasiteetti</span>
                    <span class="citybike-detail-value">@Model?.Kapasiteet</span>
                </div>

                <div class="citybike-delete-item">
                    <span class="citybike-detail-label">Koordinaatit</span>
                    <span class="citybike-detail-value">@Model?.y, @Model?.x</span>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <div class="citybike-delete-actions">
                <button type="submit" class="citybike-btn citybike-btn-danger citybike-btn-large">
                    <span>Kyllä, Poista Asema</span>
                </button>
                <a asp-action="Index" class="citybike-btn citybike-btn-secondary citybike-btn-large">
                    <span>Peruuta</span>
                </a>
            </div>
        </form>
    </div>
</div>
