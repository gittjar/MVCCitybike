@model MVCCitybike.Models.Station

@{
    ViewData["Title"] = "Details";
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    #stationMap {
        height: 400px;
        width: 100%;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        position: relative;
    }
    .map-theme-controls {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 1000;
        background: white;
        padding: 8px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }
    .theme-toggle-btn {
        margin: 2px;
        padding: 6px 10px;
        border: 2px solid #95a5a6;
        background: white;
        color: #2c3e50;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 11px;
    }
    .theme-toggle-btn:hover {
        background: #ecf0f1;
    }
    .theme-toggle-btn.active {
        background: #3498db;
        color: white;
        border-color: #3498db;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">ASEMAN TIEDOT</h1>
        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-secondary">Muokkaa</a>
            <a asp-action="Index" class="btn btn-outline-dark">Takaisin</a>
        </div>
    </div>

    <div class="card shadow-sm">
        @if (!string.IsNullOrEmpty(Model?.Kuva))
        {
            <img src="@Model.Kuva" alt="@Model.Nimi" class="card-img-top" style="max-height: 400px; object-fit: cover;">
        }
        
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <h3 class="h4 mb-3 fw-bold border-bottom pb-2">Perustiedot</h3>
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">FID</dt>
                        <dd class="col-sm-8 fw-bold">@Model?.FID</dd>
                        
                        <dt class="col-sm-4 text-muted">Nimi (FI)</dt>
                        <dd class="col-sm-8 fw-bold">@Model?.Nimi</dd>
                        
                        <dt class="col-sm-4 text-muted">Namn (SE)</dt>
                        <dd class="col-sm-8">@Model?.Namn</dd>
                        
                        <dt class="col-sm-4 text-muted">Name (EN)</dt>
                        <dd class="col-sm-8">@Model?.Name</dd>
                        
                        <dt class="col-sm-4 text-muted">Kapasiteetti</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary fs-6">@Model?.Kapasiteet</span></dd>
                        
                        <dt class="col-sm-4 text-muted">Operaattori</dt>
                        <dd class="col-sm-8">@Model?.Operaattor</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h3 class="h4 mb-3 fw-bold border-bottom pb-2">Sijainti</h3>
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Osoite (FI)</dt>
                        <dd class="col-sm-8 fw-bold">@Model?.Osoite</dd>
                        
                        <dt class="col-sm-4 text-muted">Adress (SE)</dt>
                        <dd class="col-sm-8">@Model?.Adress</dd>
                        
                        <dt class="col-sm-4 text-muted">Kaupunki (FI)</dt>
                        <dd class="col-sm-8 fw-bold">@Model?.Kaupunki</dd>
                        
                        <dt class="col-sm-4 text-muted">Stad (SE)</dt>
                        <dd class="col-sm-8">@Model?.Stad</dd>
                        
                        <dt class="col-sm-4 text-muted">Longitude (X)</dt>
                        <dd class="col-sm-8"><code>@Model?.x.ToString("G", System.Globalization.CultureInfo.InvariantCulture)</code></dd>
                        
                        <dt class="col-sm-4 text-muted">Latitude (Y)</dt>
                        <dd class="col-sm-8"><code>@Model?.y.ToString("G", System.Globalization.CultureInfo.InvariantCulture)</code></dd>
                    </dl>
                </div>
            </div>
        </div>
        
        <!-- Map Section -->
        <div class="card-body border-top">
            <h3 class="h4 mb-3 fw-bold">
                <i class="fas fa-map-marker-alt text-danger"></i> Kartta Sijainti
            </h3>
            <div id="stationMap">
                <div class="map-theme-controls">
                    <button class="theme-toggle-btn active" data-theme="osm">Street</button>
                    <button class="theme-toggle-btn" data-theme="satellite">Satellite</button>
                    <button class="theme-toggle-btn" data-theme="dark">Dark</button>
                    <button class="theme-toggle-btn" data-theme="topo">Topo</button>
                </div>
            </div>
        </div>
        
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between">
                <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-secondary">Muokkaa</a>
                <a asp-action="Index" class="btn btn-dark">Takaisin Listaan</a>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    let map;
    let marker;
    let currentTileLayer;

    // Map theme configurations
    const mapThemes = {
        osm: {
            url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        },
        satellite: {
            url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
            attribution: 'Tiles &copy; Esri'
        },
        dark: {
            url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        },
        topo: {
            url: 'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
            attribution: 'Map data: &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, <a href="http://viewfinderpanoramas.org">SRTM</a> | Map style: &copy; <a href="https://opentopomap.org">OpenTopoMap</a>'
        }
    };

    // Initialize map
    function initStationMap() {
        const lat = @Model.y.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const lng = @Model.x.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const stationName = "@Model.Nimi";
        const address = "@Model.Osoite";
        const city = "@Model.Kaupunki";
        const capacity = @Model.Kapasiteet;

        // Create map centered on station
        map = L.map('stationMap').setView([lat, lng], 15);

        // Add default tile layer
        currentTileLayer = L.tileLayer(mapThemes.osm.url, {
            attribution: mapThemes.osm.attribution,
            maxZoom: 19
        }).addTo(map);

        // Create custom marker icon
        const markerColor = capacity <= 15 ? '#e74c3c' : capacity <= 25 ? '#f39c12' : '#2ecc71';
        const customIcon = L.divIcon({
            className: 'custom-marker',
            html: `<div style="
                background-color: ${markerColor};
                width: 30px;
                height: 30px;
                border-radius: 50%;
                border: 4px solid white;
                box-shadow: 0 3px 8px rgba(0,0,0,0.4);
            "></div>`,
            iconSize: [30, 30],
            iconAnchor: [15, 15]
        });

        // Add marker for this station
        marker = L.marker([lat, lng], { icon: customIcon }).addTo(map);

        // Add popup
        marker.bindPopup(`
            <div style="min-width: 200px;">
                <h6 style="margin-bottom: 8px; color: #2c3e50;">
                    <i class="fas fa-bicycle"></i> <strong>${stationName}</strong>
                </h6>
                <p style="margin: 4px 0; font-size: 13px;">
                    <i class="fas fa-map-marker-alt" style="color: #e74c3c;"></i> ${address}
                </p>
                <p style="margin: 4px 0; font-size: 13px;">
                    <i class="fas fa-city" style="color: #3498db;"></i> ${city}
                </p>
                <p style="margin: 4px 0; font-size: 13px;">
                    <i class="fas fa-parking" style="color: #27ae60;"></i> Capacity: ${capacity} bikes
                </p>
            </div>
        `).openPopup();

        // Setup theme buttons
        document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                changeMapTheme(this.getAttribute('data-theme'));
                document.querySelectorAll('.theme-toggle-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });
    }

    // Change map theme
    function changeMapTheme(themeName) {
        if (currentTileLayer) {
            map.removeLayer(currentTileLayer);
        }
        const theme = mapThemes[themeName];
        currentTileLayer = L.tileLayer(theme.url, {
            attribution: theme.attribution,
            maxZoom: 19
        }).addTo(map);
    }

    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', initStationMap);
</script>